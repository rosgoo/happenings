---
import '../styles/app.css';
import { meta } from '../lib/data.js';

const { title, description } = Astro.props;
// Vercel serves every build at a *.vercel.app URL as well, so each page has to
// name the host that owns it -- 345 pages duplicated across two domains is the
// cheapest way to poison a domain. The trailing slash is stripped so this
// agrees with sitemap.xml; if the two disagree about /x vs /x/, they argue.
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site);
const generated = new Date(meta.generated_at).toLocaleString('en-US', {
  dateStyle: 'medium', timeStyle: 'short', timeZone: meta.tz,
});
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <!-- The two faces on every page above the fold. The serif is one paragraph
       and can swap in late; preloading all four would just make them queue. -->
  <link rel="preload" href="/fonts/archivo-var-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/archivo-black-latin.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <header class="top">
    <div class="wrap">
      <a class="wordmark" href="/nyc">happenings</a>
      <nav>
        <a href="/nyc">All</a>
        <a href="/nyc/neighborhoods">Neighborhoods</a>
        <a href="/nyc/subway">Subway</a>
        <a href="/nyc/places">Places</a>
        <a href="/nyc/venues">Venues</a>
        <a href="/nyc/about">About</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <slot />
  </main>

  <footer>
    <div class="wrap">
      <div>
        <b>happenings</b> — {meta.counts.events.toLocaleString()} events across
        {meta.counts.venues.toLocaleString()} venues in {meta.city_name},
        rebuilt {generated}.
      </div>
      <div>
        Sources: {meta.sources.map((s) => s.attribution).filter(Boolean).join(' · ')}.
        Every listing links back to where it came from — happenings is a router,
        not a destination.
      </div>
      <div>
        Facts only: title, time, place, category. Nothing is estimated — a value
        we could not establish shows as missing rather than guessed.
        <a href="/nyc/about">What's covered, and what isn't →</a>
      </div>
    </div>
  </footer>
</body>
</html>
