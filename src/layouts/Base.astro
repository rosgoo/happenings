---
import '../styles/app.css';
import Analytics from '@vercel/analytics/astro';
import { meta } from '../lib/data.js';

const { title, description } = Astro.props;
// Vercel serves every build at a *.vercel.app URL as well, so each page has to
// name the host that owns it -- 345 pages duplicated across two domains is the
// cheapest way to poison a domain. The trailing slash is stripped so this
// agrees with sitemap.xml; if the two disagree about /x vs /x/, they argue.
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site);
const generated = new Date(meta.generated_at).toLocaleString('en-US', {
  dateStyle: 'medium', timeStyle: 'short', timeZone: meta.tz,
});
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <!-- The two faces on every page above the fold. The serif is one paragraph
       and can swap in late; preloading all four would just make them queue. -->
  <link rel="preload" href="/fonts/archivo-var-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/archivo-black-latin.woff2" as="font" type="font/woff2" crossorigin />
  <!-- Pageviews. The script is served by Vercel at /_vercel/insights/ and only
       exists once Web Analytics is enabled on the project, so this is inert
       locally and on any other host. -->
  <Analytics />
</head>
<body>
  <header class="top">
    <div class="wrap">
      <a class="wordmark" href="/nyc">happenings</a>
      <nav>
        <a href="/nyc">All</a>
        <a href="/nyc/neighborhoods">Neighborhoods</a>
        <a href="/nyc/subway">Subway</a>
        <a href="/nyc/places">Places</a>
        <a href="/nyc/venues">Venues</a>
        <a href="/nyc/about">About</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <slot />
  </main>

  <footer>
    <div class="wrap">
      <div>
        <b>happenings</b> — {meta.counts.events.toLocaleString()} events across
        {meta.counts.venues.toLocaleString()} venues in {meta.city_name},
        rebuilt {generated}.
      </div>
      <div>
        Sources: {meta.sources.map((s) => s.attribution).filter(Boolean).join(' · ')}.
      </div>
      <div>
        <a href="/nyc/about">About happenings →</a>
        <!-- On every page rather than only the about page: the venue that
             wants a listing corrected has landed on its own venue page, and
             asking it to go hunting for the way to say so is how a takedown
             request becomes a complaint somewhere else instead. -->
        <span style="color:var(--ink-2)"> · </span>
        <a href="mailto:hello@happenings.town">Something wrong? hello@happenings.town</a>
      </div>
    </div>
  </footer>

  <!-- Outbound clicks. Here rather than in the listings island because the
       about, venue and neighborhood pages link off-site too and ship no other
       JavaScript. -->
  <script>
    import '../scripts/analytics.js';
  </script>
</body>
</html>
