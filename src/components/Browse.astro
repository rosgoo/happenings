---
import { CATEGORY_LABELS, catColor, catOn, fmtTime, fmtDay } from '../lib/data.js';

// scope narrows the island to one facet without needing a separate payload.
// noJs is server-rendered underneath: a crawler with no JavaScript still sees
// real listings, which is the entire point of building this statically.
const {
  scope = {}, cats = [], hoods = [], venues = [], noJs = [], places = true,
} = Astro.props;

const BANDS = [
  ['morning', 'Morning'], ['afternoon', 'Afternoon'],
  ['evening', 'Evening 5–9'], ['late', 'Late 9+'],
];

// Neighbourhoods grouped by borough. A flat list of 30 chips is a wall you read
// linearly; nobody browsing NYC wants "everywhere" -- they want Brooklyn, and
// then a place in it. Boroughs are collapsed by default so the rail stays
// short, and the count on each summary is what makes them worth opening.
// Alphabetical WITHIN a borough, not by event count. `neighborhoods()` sorts by
// count because the front page wants the busiest few, but this is a find-it
// list: you already know you want Greenpoint, and hunting for it in popularity
// order means reading all sixty. The count stays on each row, so the busy ones
// are still visible -- it is only the ordering that stops being a ranking.
const byName = (a, b) => a.name.localeCompare(b.name);
const BOROUGH_ORDER = ['Manhattan', 'Brooklyn', 'Queens', 'Bronx', 'Staten Island'];
const byBorough = BOROUGH_ORDER
  .map((b) => ({ borough: b, list: hoods.filter((h) => h.borough === b).sort(byName) }))
  .filter((g) => g.list.length);
const otherHoods = hoods.filter((h) => !BOROUGH_ORDER.includes(h.borough)).sort(byName);
if (otherHoods.length) byBorough.push({ borough: 'Elsewhere', list: otherHoods });
---
<div id="browse" class="browse" data-src="/nyc/events.json"
     data-places={places ? '/nyc/places.json' : ''}
     data-lines="/nyc/subway.json"
     data-scope={JSON.stringify(scope)}>

  <!-- Filters are a permanent left rail on desktop. Below 900px the same
       element slides in as an off-canvas panel, so there is one set of
       controls and one piece of state rather than two that can disagree. -->
  <aside id="filters" class="rail" aria-label="Filters">
    <div class="dhead">
      <b>Filters</b>
      <button class="iconbtn" id="closefilters" aria-label="Close filters">×</button>
    </div>
    <div class="dbody">
      {cats.length > 0 && (
        <>
          <div class="filterlabel">What</div>
          <div id="cats" class="chips">
            {cats.map((c) => (
              <button class="ch" data-v={c.slug} aria-pressed="false">
                <span class="dot" style={`background:${catColor(c.slug)}`}></span>
                {c.name} <span style="color:var(--ink-2)">{c.count}</span>
              </button>
            ))}
          </div>
        </>
      )}

      <div class="filterlabel">When in the day</div>
      <div id="bands" class="chips">
        {BANDS.map(([v, label]) => (
          <button class="ch" data-v={v} aria-pressed="false">{label}</button>
        ))}
      </div>

      <div class="filterlabel">Near a train</div>
      <div id="routes" class="chips routes"></div>
      <!-- Lines narrow the station list; stations are the actual filter. "Near
           the L" is a neighbourhood-sized answer, but "at Bedford Av" is where
           somebody is standing.

           With no line picked the list is the stations that have something on,
           busiest first -- there are 445 of them and an alphabetical wall is
           not a starting point. Pick a line and it becomes that line's stops in
           riding order, the empty ones included and greyed: a line you can read
           end to end is the thing a rider recognises, and "nothing at Sutter Av
           tonight" is an answer, where an absence from a list is just a gap. -->
      <input id="stationq" class="minisearch" type="search" autocomplete="off"
             placeholder="Find a station…" />
      <div id="stations" class="picklist"></div>

      {hoods.length > 0 && (
        <>
          <div class="filterlabel">Where</div>
          <input id="hoodq" class="minisearch" type="search" autocomplete="off"
                 placeholder="Find a neighborhood…" />
          <div id="hoods" class="borolist">
            {byBorough.map((g) => (
              <details class="boro" data-borough={g.borough}>
                <summary>
                  {g.borough}
                  <span class="bn">{g.list.reduce((n, h) => n + h.count, 0)}</span>
                </summary>
                <!-- A dense one-per-line list, not wrapped chips. Manhattan
                     alone is ~60 neighbourhoods; as chips that is a paragraph
                     you read word by word, and it pushed everything else in
                     the rail off the screen. -->
                <div class="picklist">
                  {g.list.map((h) => (
                    <button data-v={h.slug} data-name={h.name.toLowerCase()}
                            aria-pressed="false">
                      <span class="lbl">{h.name}</span>
                      <span class="n">{h.count}</span>
                    </button>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </>
      )}

      {venues.length > 0 && (
        <>
          <div class="filterlabel">Venue</div>
          <input id="venueq" class="minisearch" type="search" autocomplete="off"
                 placeholder="Find a venue…" />
          <div id="venues" class="picklist">
            {venues.map((v) => (
              <button data-v={v.id} data-name={v.name.toLowerCase()}
                      aria-pressed="false">
                <span class="lbl">{v.name}</span>
                <span class="n">{v.upcoming}</span>
              </button>
            ))}
          </div>
        </>
      )}
    </div>
    <div class="dfoot">
      <span id="dcount"><b>…</b></span>
      <button class="ch" id="clear" style="margin-left:auto">Clear all</button>
      <button class="ch act" id="applyfilters">Done</button>
    </div>
  </aside>

  <div class="browse-main">
    <!-- Search is the first thing on the page and never hidden. It was behind
         the filter button, which meant the single most direct way to find a
         thing was the one control you had to go looking for. -->
    <div class="searchbar">
      <input id="q" type="search" autocomplete="off"
             placeholder="Search events, venues, neighborhoods…" />
      <button class="ch filterbtn" id="openfilters">
        Filters<span class="n hide" id="fcount">0</span>
      </button>
    </div>

    <!-- The day strip stays on the page: it is navigation, not filtering, and
         its per-day counts are the fastest read of where the week is busy. -->
    <div id="strip" class="strip"></div>

    <div class="count">
      <span id="count"><b>…</b></span>
      <button class="ch" id="surprise">Surprise me →</button>
      <span id="views" class="views">
        <button class="ch" data-view="list" aria-pressed="true">List</button>
        <button class="ch" data-view="grid" aria-pressed="false">Grid</button>
      </span>
    </div>

    <div id="surprised" class="hide" style="margin-top:14px;border:2px solid var(--ink)"></div>

    <div id="results" style="margin-top:14px">
      <!-- Server-rendered fallback: replaced by the island on load, and the only
           thing a crawler without JavaScript ever sees. -->
      {noJs.map((e, i) => (
        <>
          {(i === 0 || noJs[i - 1].date_local !== e.date_local) && (
            <div class="daybar"><span>{fmtDay(e.date_local)}</span></div>
          )}
          <div class="row">
            <div class="t">{fmtTime(e.start_local) || 'all day'}</div>
            <div>
              <div class="title">
                {e.url ? <a href={e.url} rel="noopener">{e.title}</a> : e.title}
              </div>
              <div class="where">
                {e.venue_name}
                {e.neighborhood_name && <> · <a href={`/nyc/${e.neighborhood}`}>{e.neighborhood_name}</a></>}
              </div>
            </div>
            <div class="right">
              <span class="tag" style={`background:${catColor(e.category)};color:${catOn(e.category)}`}>
                {CATEGORY_LABELS[e.category]}
              </span>
            </div>
          </div>
        </>
      ))}
    </div>

    <button class="ch hide" id="more" style="margin-top:16px">Show more</button>

    <!-- Places are OPEN rather than ON, so they get their own section instead
         of being mixed into a list grouped by day. They answer the filters
         that apply to them -- what, where, which train, and now when, because
         `opening_hours` is parsed into the same four bands the listings use.
         Venue is the only filter left that cannot mean anything here.

         This section is the reason the page still has an answer when the
         listings have none: an empty Tuesday in Bushwick is not an empty
         Bushwick, and the comedy club and the roller rink were open the whole
         time. The note under the heading says what is doing the filtering, so
         a section that did not move does not read as broken. -->
    {places && (
      <section id="placesec" class="hide" style="margin-top:34px">
        <h2 class="sec">Places to go</h2><div class="rule"></div>
        <p class="lede" style="margin-top:10px">
          Not what's <em>on</em> — what's <em>open</em>.
          <span id="placenote" style="color:var(--ink-2)"></span>
        </p>
        <div id="places" class="pcards tight" style="margin-top:14px"></div>
        <p style="margin-top:12px">
          <button class="ch hide" id="moreplaces">Show more</button>
          <a href="/nyc/places" style="margin-left:10px">All places →</a>
        </p>
      </section>
    )}
  </div>
</div>

<div id="scrim"></div>

<script>
  import '../scripts/browse.js';
</script>
