---
import Base from '../../layouts/Base.astro';
import { places, PLACE_KINDS, placeColor } from '../../lib/data.js';

const kinds = [...places.reduce((m, p) => m.set(p.kind, (m.get(p.kind) || 0) + 1), new Map())]
  .map(([slug, count]) => ({ slug, count, label: PLACE_KINDS[slug] || slug }))
  .sort((a, b) => b.count - a.count);
const withPhoto = places.filter((p) => p.image_url);
// Photos first: this page is the one surface where an image is the point.
const ordered = [...withPhoto, ...places.filter((p) => !p.image_url)];
const shown = ordered.slice(0, 240);
---
<Base title="Places to go — happenings"
      description="Museums, galleries, cinemas, theatres, arcades, escape rooms and more across New York.">
  <p class="kicker" style="margin-top:26px">New York City</p>
  <h1 class="page">Places to go</h1>
  <p class="lede">Not what's <em>on</em> — what's <em>open</em>.
    {places.length.toLocaleString()} museums, galleries, cinemas, theatres,
    arcades, escape rooms and rinks, from OpenStreetMap.</p>

  <div class="chips" style="margin-top:16px">
    {kinds.map((k) => (
      <a class="ch" href={`#${k.slug}`} style={`border-left:8px solid ${placeColor(k.slug)}`}>
        {k.label} <span style="color:var(--ink-2)">{k.count}</span>
      </a>
    ))}
  </div>

  <div class="count" style="border-top:2px solid var(--ink);padding-top:14px;margin-top:18px">
    <span><b>{withPhoto.length}</b> with a photo</span>
    <span style="color:var(--ink-2)">
      Photos come from Wikimedia Commons via OpenStreetMap, hotlinked at source
      and never rehosted. Places without one get their category block — which is
      the design, not a missing image.
    </span>
  </div>

  <div class="pcards" style="margin-top:16px">
    {shown.map((p) => (
      <div class="pcard" id={p.id}>
        <div class="ph" style={`background:${placeColor(p.kind)}`}>
          {p.image_url && <img src={p.image_url} alt={p.name} loading="lazy"
                               referrerpolicy="no-referrer" decoding="async" />}
          <span class="kindtag">{PLACE_KINDS[p.kind] || p.kind}</span>
          {!p.image_url && <span class="fb">{PLACE_KINDS[p.kind] || p.kind}</span>}
        </div>
        <div class="pb">
          <h3>{p.website ? <a href={p.website} rel="noopener">{p.name}</a> : p.name}</h3>
          <div class="w">
            {p.neighborhood_name
              ? <a href={`/nyc/${p.neighborhood}`} style="color:var(--ink-2)">{p.neighborhood_name}</a>
              : (p.borough || '')}
          </div>
        </div>
        {p.image_credit && (
          <div class="cred">
            Photo: {p.image_page
              ? <a href={p.image_page} rel="noopener">{p.image_credit}</a>
              : p.image_credit} · Wikimedia Commons
          </div>
        )}
      </div>
    ))}
  </div>
  {ordered.length > shown.length && (
    <p style="margin-top:14px;color:var(--ink-2)">
      Showing {shown.length} of {ordered.length}.
    </p>
  )}
</Base>
