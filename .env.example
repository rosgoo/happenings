# Copy to .env and fill in. .env is gitignored; this file is not.
# Names only here — never paste a real value into this file.

# Ticketmaster Discovery API. Free key from https://developer-acct.ticketmaster.com/
# The "Consumer Key" is the one you want, not the Consumer Secret.
TICKETMASTER_API_KEY=

# Sent in the User-Agent of every outbound request so venues can identify us.
# Defaults to the repo URL when unset.
HAPPENINGS_CONTACT=
